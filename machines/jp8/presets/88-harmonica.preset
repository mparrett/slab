{"slab": "preset", "schema": 1, "machine": "jp8", "note": "88 HARMONICA: Blues harp: VCO-2 saw at 4' synced to a square VCO-1, with ENV-1 (A 3.5, D 5, S 5) sweeping VCO-2 pitch at 2.5 for a sync reed bite; 12 dB filter at 5, res 3, HPF 2.5, full key follow; env key follows on. Left third of the sheet is washed out.", "params": {"jp-lfo-rate": 3.855, "jp-lfo-delay": 1.6, "jp-lfo-wave": 0, "jp-lfo-vco": 1.5, "jp-env-vco": 2.5, "jp-vmod-dst": 2, "jp-cross": 0, "jp-range1": 1, "jp-wave1": 3, "jp-range2": 12, "jp-fine2": 0.7, "jp-wave2": 1, "jp-sync": 1, "jp-low2": 0, "jp-pwm": 0, "jp-pwm-src": 1, "jp-mix": 5.5, "jp-hpf": 2.5, "jp-slope": 1, "jp-cutoff": 5, "jp-res": 3, "jp-env-src": 0, "jp-env-mod": 1.5, "jp-lfo-vcf": 2, "jp-kf": 10, "jp-vca-lfo": 0, "jp-level": 4.5, "jp-e1-a": 0.0273, "jp-e1-d": 0.1342, "jp-e1-s": 5, "jp-e1-r": 0.0222, "jp-e1-kf": 1, "jp-e1-pol": 0, "jp-e2-a": 0.0273, "jp-e2-d": 0.0142, "jp-e2-s": 6.5, "jp-e2-r": 0.0091, "jp-e2-kf": 1, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 3, "jp-bend-v1": 1, "jp-bend-v2": 1, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
