{"slab": "preset", "schema": 1, "machine": "jp8", "note": "44 CHIFF ORGAN: Chiff organ: VCO-1 square 8' with VCO-2 pulse synced to it, VCO-2 set between 4' and 2' (pointer +85 deg; read as +19), ENV-1 short decay at full env mod gives the 12 dB filter chiff, ENV-2 swell on the VCA.", "params": {"jp-lfo-rate": 0.725, "jp-lfo-delay": 0.0, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 0, "jp-vmod-dst": 1, "jp-cross": 0, "jp-range1": 1, "jp-wave1": 3, "jp-range2": 19, "jp-fine2": -0.7, "jp-wave2": 2, "jp-sync": 1, "jp-low2": 0, "jp-pwm": 2, "jp-pwm-src": 1, "jp-mix": 5, "jp-hpf": 0, "jp-slope": 1, "jp-cutoff": 4, "jp-res": 0, "jp-env-src": 0, "jp-env-mod": 10, "jp-lfo-vcf": 0, "jp-kf": 6.5, "jp-vca-lfo": 0, "jp-level": 4, "jp-e1-a": 0.0015, "jp-e1-d": 0.0222, "jp-e1-s": 1.5, "jp-e1-r": 0.0015, "jp-e1-kf": 0, "jp-e1-pol": 0, "jp-e2-a": 0.0627, "jp-e2-d": 0.0222, "jp-e2-s": 7.5, "jp-e2-r": 0.0058, "jp-e2-kf": 0, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 1, "jp-bend-v2": 1, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
