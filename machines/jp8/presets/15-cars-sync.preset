{"slab": "preset", "schema": 1, "machine": "jp8", "note": "15 CARS SYNC: Classic sync lead: VCO-2 pulse alone (mix fully VCO-2) synced to a 16-foot square, ENV-1 decay sweeping VCO-2 pitch for the sync zap, 12 dB filter on ENV-2. [raw: range2_raw_deg=-132, mix_raw_deg=158]. Roland plays it in UNISON: turn UNI on", "params": {"jp-lfo-rate": 3.855, "jp-lfo-delay": 0.0, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 8.5, "jp-vmod-dst": 2, "jp-cross": 0, "jp-range1": 0, "jp-wave1": 3, "jp-range2": -12, "jp-fine2": 1.1, "jp-wave2": 2, "jp-sync": 1, "jp-low2": 0, "jp-pwm": 0, "jp-pwm-src": 1, "jp-mix": 10, "jp-hpf": 0, "jp-slope": 1, "jp-cutoff": 6, "jp-res": 2.5, "jp-env-src": 1, "jp-env-mod": 5, "jp-lfo-vcf": 0, "jp-kf": 0, "jp-vca-lfo": 0, "jp-level": 3, "jp-e1-a": 0.0015, "jp-e1-d": 1.9887, "jp-e1-s": 0, "jp-e1-r": 0.0015, "jp-e1-kf": 0, "jp-e1-pol": 0, "jp-e2-a": 0.0015, "jp-e2-d": 12.0, "jp-e2-s": 0, "jp-e2-r": 0.0015, "jp-e2-kf": 0, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 1, "jp-bend-v2": 1, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
