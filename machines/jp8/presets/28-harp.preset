{"slab": "preset", "schema": 1, "machine": "jp8", "note": "28 HARP: Triangle plus mid-width pulse at 8-foot unison, filter fully closed and opened by key-followed ENV-1 (env mod 8.5), ENV-2 decay to zero with long release for the pluck ring. [raw: range2_raw_deg=-36]", "params": {"jp-lfo-rate": 0.05, "jp-lfo-delay": 0.0, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 0, "jp-vmod-dst": 1, "jp-cross": 0, "jp-range1": 1, "jp-wave1": 0, "jp-range2": 0, "jp-fine2": 1.5, "jp-wave2": 2, "jp-sync": 0, "jp-low2": 0, "jp-pwm": 4, "jp-pwm-src": 1, "jp-mix": 5, "jp-hpf": 0, "jp-slope": 0, "jp-cutoff": 0, "jp-res": 0, "jp-env-src": 0, "jp-env-mod": 8.5, "jp-lfo-vcf": 0, "jp-kf": 7.5, "jp-vca-lfo": 0, "jp-level": 10, "jp-e1-a": 0.0015, "jp-e1-d": 0.0856, "jp-e1-s": 6, "jp-e1-r": 1.2688, "jp-e1-kf": 1, "jp-e1-pol": 0, "jp-e2-a": 0.0015, "jp-e2-d": 0.1342, "jp-e2-s": 0, "jp-e2-r": 1.9887, "jp-e2-kf": 1, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 0, "jp-bend-v2": 0, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
