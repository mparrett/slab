{"slab": "preset", "schema": 1, "machine": "jp8", "note": "81 CLARINET: Clarinet: SOURCE MIX turned fully to VCO-2 (pointer past 10), an 8' pulse at PWM 0 (square); 24 dB filter at 3 opened by ENV-1 (A 1, D 3, S 3.5) at 7 with key follow 4 and a little LFO; ENV-2 organ-like VCA. VCO-1 (16' square) is silent.", "params": {"jp-lfo-rate": 5.384, "jp-lfo-delay": 2.4, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 0, "jp-vmod-dst": 1, "jp-cross": 0, "jp-range1": 0, "jp-wave1": 3, "jp-range2": 0, "jp-fine2": 1.5, "jp-wave2": 2, "jp-sync": 0, "jp-low2": 0, "jp-pwm": 0, "jp-pwm-src": 1, "jp-mix": 10, "jp-hpf": 0, "jp-slope": 0, "jp-cutoff": 3, "jp-res": 0, "jp-env-src": 0, "jp-env-mod": 7, "jp-lfo-vcf": 1.5, "jp-kf": 4, "jp-vca-lfo": 0, "jp-level": 5.5, "jp-e1-a": 0.0034, "jp-e1-d": 0.0222, "jp-e1-s": 3.5, "jp-e1-r": 0.0091, "jp-e1-kf": 0, "jp-e1-pol": 0, "jp-e2-a": 0.0015, "jp-e2-d": 12.0, "jp-e2-s": 10, "jp-e2-r": 0.0142, "jp-e2-kf": 0, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 1, "jp-bend-v2": 1, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
