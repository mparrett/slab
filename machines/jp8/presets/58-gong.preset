{"slab": "preset", "schema": 1, "machine": "jp8", "note": "58 GONG: An 8' pulse cross-modulated by a sine a few semitones above gives inharmonic metal; ENV-1 (inverted) drives full PWM and the filter, ENV-2 rings out with long release.. Roland plays it in UNISON: turn UNI on", "params": {"jp-lfo-rate": 1.414, "jp-lfo-delay": 0.0, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 0, "jp-vmod-dst": 1, "jp-cross": 5.5, "jp-range1": 1, "jp-wave1": 2, "jp-range2": 4, "jp-fine2": -0.7, "jp-wave2": 0, "jp-sync": 0, "jp-low2": 0, "jp-pwm": 10, "jp-pwm-src": 2, "jp-mix": 5, "jp-hpf": 0, "jp-slope": 0, "jp-cutoff": 7, "jp-res": 5.5, "jp-env-src": 0, "jp-env-mod": 4.5, "jp-lfo-vcf": 0, "jp-kf": 0, "jp-vca-lfo": 0, "jp-level": 5.5, "jp-e1-a": 0.0015, "jp-e1-d": 0.2103, "jp-e1-s": 3.5, "jp-e1-r": 0.0856, "jp-e1-kf": 0, "jp-e1-pol": 1, "jp-e2-a": 0.0015, "jp-e2-d": 0.0015, "jp-e2-s": 10, "jp-e2-r": 0.8096, "jp-e2-kf": 0, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 0, "jp-bend-v2": 0, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
