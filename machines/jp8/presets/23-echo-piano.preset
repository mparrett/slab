{"slab": "preset", "schema": 1, "machine": "jp8", "note": "23 ECHO PIANO: Two saws an octave apart; ENV-1 (A0 D0 S10 R0) holds VCO-2 pitch up via env mod 8.5 while the key is down and drops it at release, so the ENV-2 release tail sounds as a shifted echo. [raw: range2_raw_deg=40]", "params": {"jp-lfo-rate": 2.759, "jp-lfo-delay": 0.0, "jp-lfo-wave": 0, "jp-lfo-vco": 0, "jp-env-vco": 8.5, "jp-vmod-dst": 2, "jp-cross": 0, "jp-range1": 1, "jp-wave1": 1, "jp-range2": 12, "jp-fine2": -1.5, "jp-wave2": 1, "jp-sync": 0, "jp-low2": 0, "jp-pwm": 0, "jp-pwm-src": 1, "jp-mix": 6, "jp-hpf": 0, "jp-slope": 0, "jp-cutoff": 3.5, "jp-res": 4.5, "jp-env-src": 1, "jp-env-mod": 4, "jp-lfo-vcf": 0, "jp-kf": 6.5, "jp-vca-lfo": 0, "jp-level": 7.5, "jp-e1-a": 0.0015, "jp-e1-d": 0.0015, "jp-e1-s": 10, "jp-e1-r": 0.0015, "jp-e1-kf": 0, "jp-e1-pol": 0, "jp-e2-a": 0.0015, "jp-e2-d": 0.5165, "jp-e2-s": 5, "jp-e2-r": 0.8096, "jp-e2-kf": 0, "jp-bend": 0.0, "jp-bend-vco": 2, "jp-bend-vcf": 0, "jp-bend-v1": 0, "jp-bend-v2": 0, "jp-porta": 0, "jp-porta-t": 0.15, "jp-tune": 0.0, "jp-age": 0.3, "jp-vol": 0.7}}
